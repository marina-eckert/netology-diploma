{
  "name": "netology-library-diploma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsc -p tsconfig.server.json && concurrently \"tsc -p tsconfig.server.json --watch\" \"node --watch dist-server/main.js\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json && vite build",
    "start": "node dist-server/main.js",
    "test": "tsx --test tests/*.test.ts",
    "design:extract": "node scripts/extract-design.cjs",
    "test:integration": "node tests/integration.mjs",
    "format": "prettier --write src server tests scripts *.json *.ts *.yaml README.md",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@reduxjs/toolkit": "^2.5.0",
    "bcryptjs": "^3.0.0",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "express-session": "^1.18.0",
    "kiwi-schema": "^0.5.0",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.0",
    "@types/passport-local": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "fig-kiwi": "^0.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "multer": "$multer",
    "typeorm": {
      "glob": "^14.0.3"
    }
  }
}
